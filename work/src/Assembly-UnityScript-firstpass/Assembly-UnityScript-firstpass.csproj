      <HintPath>unpacked/Boo.Lang.dll</HintPath>
    </Reference>
    <Reference Include="UnityScript.Lang">
      <HintPath>unpacked/UnityScript.Lang.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>